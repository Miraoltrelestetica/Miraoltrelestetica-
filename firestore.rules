rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Titolare: accesso con email e password, riconosciuta dal suo UID
    function titolare() {
      return request.auth != null && request.auth.uid == 'nIeROc5fGAbNzGQOHRJxRk4jM8m2';
    }
    function acceduta() {
      return request.auth != null;
    }

    // Prenotazioni: ogni cliente vede e crea solo le proprie. La titolare vede e gestisce tutto.
    match /appointments/{id} {
      allow read: if titolare() || (acceduta() && resource.data.uid == request.auth.uid);

      allow create: if titolare() || (
        acceduta()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.stato == 'attesa'
        && request.resource.data.keys().hasOnly(['uid','gruppo','nome','cognome','tel','sv','op','data','inizio','fine','stato','creato'])
        && request.resource.data.op in ['m','a','r']
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && request.resource.data.cognome is string && request.resource.data.cognome.size() > 0 && request.resource.data.cognome.size() <= 60
        && request.resource.data.tel is string && request.resource.data.tel.size() >= 6 && request.resource.data.tel.size() <= 25
        && request.resource.data.inizio is int && request.resource.data.fine is int
        && request.resource.data.fine > request.resource.data.inizio
        && request.resource.data.inizio >= 540 && request.resource.data.fine <= 1140
      );

      // La cliente può solo annullare la propria prenotazione
      allow update: if titolare() || (
        acceduta()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stato','annullatoDa'])
        && request.resource.data.stato == 'annullato'
      );

      allow delete: if titolare();
    }

    // Orari occupati: un documento ogni 5 minuti per operatrice (id = data_operatrice_minuto).
    // Non contiene dati personali. Un documento già esistente non si può ricreare:
    // così due clienti non possono prenotare lo stesso orario nello stesso istante.
    match /busy/{id} {
      allow read: if true;
      allow create: if titolare() || (
        acceduta()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['data','op','m','aid','uid'])
        && request.resource.data.op in ['m','a','r']
        && request.resource.data.m is int
        && id == request.resource.data.data + '_' + request.resource.data.op + '_' + string(request.resource.data.m)
      );
      allow update: if titolare();
      allow delete: if titolare() || (acceduta() && resource.data.uid == request.auth.uid);
    }

    // Schede clienti e note private: solo la titolare
    match /clienti/{id} {
      allow read, write: if titolare();
    }
  }
}
